{
  "manifest_version": 3,
  "name": "youtube-dl Downloader",
  "description": "Download video or audio from the current tab as MP4, MP3, or WAV, with quality options, via a native messaging host running yt-dlp.",
  "key": "",
  "permissions": [
    "activeTab",
    "notifications",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Download video or audio from this page",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
