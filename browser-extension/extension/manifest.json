{
  "manifest_version": 2,
  "name": "youtube-dl Downloader",
  "version": "0.3.0",
  "description": "Download the YouTube video on the current tab as MP4, MP3, or WAV, with quality options, via a native messaging host.",
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-dl-extension@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "activeTab",
    "notifications",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Download this video"
  }
}
